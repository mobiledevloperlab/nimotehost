{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nimote:plugin-wire:1.0",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "enum": [
        "initialize",
        "ping",
        "invoke"
      ]
    },
    "protocol": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "input": {},
    "result": {},
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
