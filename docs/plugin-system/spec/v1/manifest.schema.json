{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nimote:plugin-manifest:1.0",
  "title": "Nimote Plugin Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "version",
    "publisher",
    "source",
    "entrypoint",
    "sha256",
    "platforms",
    "permissions",
    "capabilities"
  ],
  "properties": {
    "protocol": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "enum": [
        "plugin",
        "plugin.exe"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "contains": {
        "const": "process.same-user"
      },
      "items": {
        "enum": [
          "process.same-user",
          "network.public"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "version",
          "title",
          "input_schema",
          "output_schema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "kind": {
            "enum": [
              "agent",
              "tool",
              "task",
              "event"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "ui": {
            "type": "object"
          },
          "sensitive": {
            "type": "boolean"
          },
          "acp_version": {
            "enum": [
              1,
              2
            ]
          }
        }
      }
    }
  }
}
