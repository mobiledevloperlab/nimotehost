{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nimote:plugin-catalog:1.0",
  "title": "Nimote metadata-only plugin catalog 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugins"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plugins": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "repository",
          "version",
          "tag",
          "assets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 2048
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "tag": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
          },
          "assets": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "propertyNames": {
              "pattern": "^(linux|darwin|windows)/(amd64|arm64|386)$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "manifest_asset",
                "manifest_sha256",
                "binary_asset"
              ],
              "properties": {
                "manifest_asset": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
                },
                "manifest_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "binary_asset": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
